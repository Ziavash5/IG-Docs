# Copy to .env.local for local dev, and set the same keys in the Vercel dashboard.
# NEVER commit real values — .env files are gitignored.

# Claude API — writer, fact-checker, corridor source-selection.
# Get from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI — embeddings + reranking for the RAG corpus.
# Get from https://dashboard.voyageai.com
VOYAGE_API_KEY=pa-...

# Jina Reader — renders bot-protected / JS pages during ingestion (canada.ca, etc.).
# Works anonymously at low rate; a key raises limits. https://jina.ai/reader
JINA_API_KEY=jina_...

# Secret for the scheduled freshness cron (Vercel Cron sends it as a Bearer token).
CRON_SECRET=change-me

# Operator console (/admin) HTTP Basic auth. Pick any values; without them /admin is
# blocked entirely (fail closed).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Supabase Postgres (with pgvector) — the RAG corpus + units.
# Supabase dashboard → Project Settings → Database → Connection string (URI).
# Use the "Session"/direct connection for migrations; the pooled string for the app.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
